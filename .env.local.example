# Copy this file to .env.local and fill in your API keys.
# Daybook Agent will not start the video pipeline for any step whose key is missing —
# check the Settings page in the app for live status of each key.

# Anthropic (Claude) — used for script writing and the compliance review step.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs — used for text-to-speech voiceover generation.
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Kling AI video generation, via fal.ai's hosted Kling models — used to generate the
# reference character image and every beat's video clip.
# Get a key ("FAL_KEY") at https://fal.ai/dashboard/keys
KLING_API_KEY=

# Optional: override the fal.ai model slugs used for video/image generation if the
# defaults in lib/kling.ts stop working (fal.ai model paths change over time).
# KLING_VIDEO_MODEL=fal-ai/kling-video/v1.6/standard/image-to-video
# KLING_IMAGE_MODEL=fal-ai/flux/schnell
